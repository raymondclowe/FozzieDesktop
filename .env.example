# FozzieDesktop Environment Variables
# Copy this file to .env and fill in your API keys for local development

# ===== RECOMMENDED: OpenRouter (Multiple Models, Cost-Effective) =====
# Get your key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here

# ===== Alternative: OpenAI (Official Models) =====
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# ===== Alternative: Groq (Ultra-Fast Inference) =====
# Get your key from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your-groq-api-key-here

# ===== Alternative: Cloudflare AI (Workers AI) =====
# Get your key from: https://dash.cloudflare.com/profile/api-tokens
# Also requires your Cloudflare Account ID
CLOUDFLARE_API_KEY=your-cloudflare-api-key-here
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id-here

# ===== Generic Fallbacks =====
AI_API_KEY=your-api-key-here
API_KEY=your-api-key-here

# Development Notes:
# - Only one API key is needed
# - Priority order: OPENROUTER_API_KEY > OPENAI_API_KEY > CLOUDFLARE_API_KEY > GROQ_API_KEY > AI_API_KEY > API_KEY
# - OpenRouter recommended for variety and cost-effectiveness
# - Groq recommended for speed (free tier available)
# - Cloudflare AI good for Workers integration
# - In GitHub Actions, secrets are provided as repository secrets
# - Never commit your actual API keys to version control

# Supported Provider Endpoints:
# - OpenRouter: https://openrouter.ai/api/v1
# - OpenAI: https://api.openai.com/v1  
# - Groq: https://api.groq.com/openai/v1
# - Cloudflare AI: https://api.cloudflare.com/client/v4/accounts/{account_id}/ai/v1